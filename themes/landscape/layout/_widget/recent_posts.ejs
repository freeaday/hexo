<% if (site.posts.length){ %>
  <div class="widget-wrap">
    <h3 class="widget-title"><%= __('recent_posts') %></h3>
    <div class="widget">
      <ul>
        <% site.posts.sort('date', -1).limit(theme.recent_posts_limits).each(function(post){ %>
          <li>
            <a href="<%- url_for(post.path) %>"><%= post.title || '(no title)' %></a>
          </li>
        <% }) %>
      </ul>
<script type="text/javascript" src="https://feed.informer.com/widgets/MF3BLOWQF5.js"></script>
<div id="rsstcview126b1a9bd283"></div>
<script src="https://rss.tc/app/rssreader?url=http%3A%2F%2Ffeeds.feedburner.com%2Ffreeaday&displayRow=10&dispTitle=1&dispTime=1&id=126b1a9bd283&target=_blank&skin=Green&innerHtml=true" async></script>
    </div>
  </div>
<% } %>
